{
  "name": "@crawlora-org/airbnb",
  "version": "0.1.1",
  "description": "Crawlora Airbnb API client with 7 endpoints for listing search, room details, calendars and reviews, and host profiles, listings and reviews",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=airbnb-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-airbnb/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "airbnb", "airbnb-api", "airbnb-scraper", "airbnb-data", "airbnb-listing-search", "airbnb-room-details", "airbnb-calendars-reviews", "airbnb-host-profiles", "airbnb-listings-reviews"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-airbnb",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
