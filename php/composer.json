{
  "name": "crawlora/airbnb",
  "description": "Crawlora Airbnb API client with 7 endpoints for listing search, room details, calendars and reviews, and host profiles, listings and reviews",
  "keywords": [
    "crawlora",
    "api-client",
    "web-scraping",
    "airbnb",
    "listing-search",
    "room-details",
    "calendars-reviews",
    "host-profiles",
    "listings-reviews"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Crawlora\\Airbnb\\": "src/Crawlora/Airbnb/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crawlora\\Airbnb\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/client_test.php"
  },
  "homepage": "https://crawlora.net/?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=airbnb-php-homepage",
  "support": {
    "source": "https://github.com/Crawlora-org/crawlora-airbnb",
    "docs": "https://crawlora.net/docs?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=airbnb-php-api-docs"
  }
}
