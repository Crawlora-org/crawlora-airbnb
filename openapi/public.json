        "is_guest_favorite": {
          "description": "IsGuestFavorite reports whether the listing carries an Airbnb Guest Favorite badge\n(including its \"top N%\" variants). Like IsSuperhost it comes from the search card's\nbadges[] and renders inconsistently, so a true value is reliable but a false/absent\nvalue is not — downstream aggregates treat the rate as an observed lower bound.",
          "type": "boolean"
        },
        "is_superhost": {
          "description": "True when the listing carries the Superhost badge.",
          "type": "boolean"
        },
        "latitude": {
