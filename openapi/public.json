            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "429": {
            "description": "Too Many Requests",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "503": {
            "description": "Service Unavailable",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Get Airbnb host listings",
        "tags": [
          "airbnb"
        ]
      }
    },
