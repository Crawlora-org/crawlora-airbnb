    "airbnb.ListingItem": {
      "properties": {
        "host": {
          "description": "Host name, when the search card shows it.",
          "type": "string"
        },
        "host_id": {
          "description": "Airbnb id of the host. Use it with the host endpoint.",
          "example": "65056940",
