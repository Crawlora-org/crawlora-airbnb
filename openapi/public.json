          "type": "string"
        },
        "longitude": {
          "description": "Longitude of the listing.",
          "type": "number"
        },
        "price": {
          "description": "Price shown on the search card. With check-in and check-out dates it is the total for the stay; without dates it is Airbnb's display figure, not a nightly rate.",
          "type": "number"
        },
        "price_per_night": {
          "description": "PricePerNight is the per-night price for the queried stay (search total ÷ nights),\nset only when check_in+check_out are supplied. It amortizes any fixed fees across\nthe stay, so a longer window yields a tighter base-rate estimate. Without dates the\n`price` field is an unstable \"from\"/display figure, not a nightly rate.",
          "example": 148,
          "type": "number"
        },
        "rating": {
          "description": "Average guest rating.",
          "type": "number"
        },
        "review_count": {
          "description": "Number of guest reviews.",
          "type": "integer"
        },
        "title": {
          "description": "Listing title as shown on the search card.",
          "type": "string"
